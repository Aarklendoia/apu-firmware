# Settings form
msgid "Daily check"
msgstr "Καθημερινός έλεγχος"

msgid "Check for new firmware every night. New versions are announced in the system status."
msgstr "Έλεγχος για νέο υλικολογισμικό κάθε νύχτα. Οι νέες εκδόσεις ανακοινώνονται στην κατάσταση συστήματος."

msgid "GitHub repository"
msgstr "Αποθετήριο GitHub"

msgid "owner/apu-firmware"
msgstr "κάτοχος/apu-firmware"

msgid "Repository whose releases contain the firmware builds (owner/name)."
msgstr "Αποθετήριο του οποίου οι εκδόσεις περιέχουν τις εκδόσεις μεταγλώττισης του υλικολογισμικού (κάτοχος/όνομα)."

msgid "Access token"
msgstr "Διακριτικό πρόσβασης"

msgid "Only for a private repository: fine-grained token with read-only access to its contents."
msgstr "Μόνο για ιδιωτικό αποθετήριο: διακριτικό λεπτομερών δικαιωμάτων με πρόσβαση μόνο ανάγνωσης στο περιεχόμενό του."

msgid "Firmware variant"
msgstr "Παραλλαγή υλικολογισμικού"

msgid "Must match the firmware currently installed. Changing variant is not supported from here."
msgstr "Πρέπει να αντιστοιχεί στο υλικολογισμικό που είναι εγκατεστημένο. Η αλλαγή παραλλαγής δεν υποστηρίζεται από εδώ."

msgid "Release candidates"
msgstr "Υποψήφιες εκδόσεις"

msgid "Also offer Dasharo release candidates (-rc) and builds of unreleased branches, for testing. They are not final releases. The final release is offered once it is out, and a release candidate is never offered over it."
msgstr "Προτείνονται επίσης οι υποψήφιες εκδόσεις του Dasharo (-rc) και εκδόσεις μεταγλώττισης από μη δημοσιευμένους κλάδους, για δοκιμές. Δεν είναι τελικές εκδόσεις. Η τελική έκδοση προτείνεται μόλις κυκλοφορήσει, και μια υποψήφια έκδοση δεν προτείνεται ποτέ στη θέση της."

# System status (notification bell)
msgid "APU coreboot firmware"
msgstr "Υλικολογισμικό coreboot του APU"

msgid "New firmware has been written. A cold reset is required to start it."
msgstr "Το νέο υλικολογισμικό γράφτηκε. Απαιτείται ψυχρή επανεκκίνηση για να ξεκινήσει."

msgid "Firmware update failed: %s"
msgstr "Η ενημέρωση του υλικολογισμικού απέτυχε: %s"

msgid "Firmware %s is available (installed: %s)."
msgstr "Το υλικολογισμικό %s είναι διαθέσιμο (εγκατεστημένο: %s)."

# Firmware page
msgid "Firmware"
msgstr "Υλικολογισμικό"

msgid "Board"
msgstr "Πλακέτα"

msgid "Installed"
msgstr "Εγκατεστημένο"

msgid "Latest build"
msgstr "Πιο πρόσφατη μεταγλώττιση"

msgid "Last check"
msgstr "Τελευταίος έλεγχος"

msgid "Status"
msgstr "Κατάσταση"

msgid "Check now"
msgstr "Έλεγχος τώρα"

msgid "Update firmware"
msgstr "Ενημέρωση υλικολογισμικού"

msgid "Cold reset"
msgstr "Ψυχρή επανεκκίνηση"

msgid "Not a PC Engines APU"
msgstr "Δεν είναι PC Engines APU"

msgid "new"
msgstr "νέο"

msgid "Not checked yet."
msgstr "Δεν έχει ελεγχθεί ακόμη."

msgid "An update is available."
msgstr "Υπάρχει διαθέσιμη ενημέρωση."

msgid "Up to date."
msgstr "Ενημερωμένο."

msgid "The current firmware will be backed up, then the new one written and verified. Do not cut the power during the update. A cold reset is needed afterwards to start the new firmware. Continue?"
msgstr "Θα δημιουργηθεί αντίγραφο ασφαλείας του τρέχοντος υλικολογισμικού και στη συνέχεια το νέο θα γραφτεί και θα επαληθευτεί. Μην διακόψετε την τροφοδοσία κατά την ενημέρωση. Μετά θα χρειαστεί ψυχρή επανεκκίνηση για να ξεκινήσει το νέο υλικολογισμικό. Συνέχεια;"

msgid "Update"
msgstr "Ενημέρωση"

msgid "Cancel"
msgstr "Ακύρωση"

msgid "Services will be stopped and the board powered off for a few seconds, then it will boot the new firmware. The network will be down for a few minutes. Continue?"
msgstr "Οι υπηρεσίες θα σταματήσουν και η πλακέτα θα απενεργοποιηθεί για λίγα δευτερόλεπτα, έπειτα θα εκκινήσει με το νέο υλικολογισμικό. Το δίκτυο θα είναι εκτός λειτουργίας για λίγα λεπτά. Συνέχεια;"

msgid "Restarting. Reload this page in a few minutes."
msgstr "Επανεκκίνηση σε εξέλιξη. Φορτώστε ξανά αυτή τη σελίδα σε λίγα λεπτά."

# Backend messages (apufw.py)
msgid "The flash is write protected (%s) and the whole image must be written: disable the protection. Nothing was written."
msgstr "Η μνήμη flash έχει προστασία εγγραφής (%s) και πρέπει να γραφτεί ολόκληρη η εικόνα: απενεργοποιήστε την προστασία. Δεν γράφτηκε τίποτα."

msgid "The flash is write protected (%s) and covers %s: disable the protection. Nothing was written."
msgstr "Η μνήμη flash έχει προστασία εγγραφής (%s) και η προστασία καλύπτει %s: απενεργοποιήστε την προστασία. Δεν γράφτηκε τίποτα."

msgid "The flash is write protected (%s): only RW_SECTION_A could be written, but the flash layout differs. Nothing was written."
msgstr "Η μνήμη flash έχει προστασία εγγραφής (%s): μόνο το RW_SECTION_A θα μπορούσε να γραφτεί, αλλά η διάταξη της flash διαφέρει. Δεν γράφτηκε τίποτα."

msgid "The flash is write protected (%s): only RW_SECTION_A could be written, but it is signed with other keys than the read-only part (GBB), which would reject it. Nothing was written."
msgstr "Η μνήμη flash έχει προστασία εγγραφής (%s): μόνο το RW_SECTION_A θα μπορούσε να γραφτεί, αλλά είναι υπογεγραμμένο με άλλα κλειδιά από το τμήμα μόνο ανάγνωσης (GBB), το οποίο θα το απέρριπτε. Δεν γράφτηκε τίποτα."

msgid "This is not a PC Engines apu2/3/4/6 board."
msgstr "Αυτή δεν είναι πλακέτα PC Engines apu2/3/4/6."

msgid "flashrom is not installed."
msgstr "Το flashrom δεν είναι εγκατεστημένο."

msgid "The current firmware version could not be read."
msgstr "Δεν ήταν δυνατή η ανάγνωση της έκδοσης του τρέχοντος υλικολογισμικού."

msgid "Switching from UEFI to SeaBIOS must be done manually."
msgstr "Η μετάβαση από UEFI σε SeaBIOS πρέπει να γίνει χειροκίνητα."

msgid "Switching from SeaBIOS to UEFI must be done manually (OPNsense must boot in UEFI mode)."
msgstr "Η μετάβαση από SeaBIOS σε UEFI πρέπει να γίνει χειροκίνητα (το OPNsense πρέπει να εκκινεί σε λειτουργία UEFI)."

msgid "Firmware %s is running."
msgstr "Εκτελείται το υλικολογισμικό %s."

msgid "The last operation was interrupted, see the log."
msgstr "Η τελευταία λειτουργία διακόπηκε, δείτε το αρχείο καταγραφής."

msgid "No GitHub repository configured."
msgstr "Δεν έχει ρυθμιστεί αποθετήριο GitHub."

msgid "Unsupported board."
msgstr "Μη υποστηριζόμενη πλακέτα."

msgid "GitHub query failed: %s"
msgstr "Το ερώτημα στο GitHub απέτυχε: %s"

msgid "No release for %s (%s) in %s."
msgstr "Καμία έκδοση για %s (%s) στο %s."

msgid "Unexpected error: %s"
msgstr "Μη αναμενόμενο σφάλμα: %s"

msgid "Preparing"
msgstr "Προετοιμασία"

msgid "No newer firmware is available."
msgstr "Δεν υπάρχει νεότερο υλικολογισμικό."

msgid "Downloading %s"
msgstr "Λήψη %s"

msgid "Download failed: %s"
msgstr "Η λήψη απέτυχε: %s"

msgid "Checksum mismatch for %s (expected %s, got %s)."
msgstr "Λάθος άθροισμα ελέγχου για %s (αναμενόταν %s, ελήφθη %s)."

msgid "Backing up the current firmware"
msgstr "Αντίγραφο ασφαλείας του τρέχοντος υλικολογισμικού"

msgid "Backup failed, nothing was written. Is the firmware write protection disabled?"
msgstr "Το αντίγραφο ασφαλείας απέτυχε, δεν γράφτηκε τίποτα. Είναι απενεργοποιημένη η προστασία εγγραφής του υλικολογισμικού;"

msgid "Writing %s"
msgstr "Εγγραφή %s"

msgid "flashrom failed while writing. DO NOT REBOOT: retry the update, or restore %s with flashrom."
msgstr "Το flashrom απέτυχε κατά την εγγραφή. ΜΗΝ ΚΑΝΕΤΕ ΕΠΑΝΕΚΚΙΝΗΣΗ: δοκιμάστε ξανά την ενημέρωση ή επαναφέρετε το %s με το flashrom."

msgid "flashrom failed before writing, the firmware is unchanged."
msgstr "Το flashrom απέτυχε πριν από την εγγραφή, το υλικολογισμικό δεν άλλαξε."

msgid "Firmware %s written and verified. A cold reset is required."
msgstr "Το υλικολογισμικό %s γράφτηκε και επαληθεύτηκε. Απαιτείται ψυχρή επανεκκίνηση."
