# Settings form
msgid "Daily check"
msgstr "Denní kontrola"

msgid "Check for new firmware every night. New versions are announced in the system status."
msgstr "Každou noc hledat nový firmware. Nové verze se oznamují ve stavu systému."

msgid "GitHub repository"
msgstr "Repozitář GitHub"

msgid "owner/apu-firmware"
msgstr "vlastník/apu-firmware"

msgid "Repository whose releases contain the firmware builds (owner/name)."
msgstr "Repozitář, jehož vydání obsahují sestavení firmwaru (vlastník/název)."

msgid "Access token"
msgstr "Přístupový token"

msgid "Only for a private repository: fine-grained token with read-only access to its contents."
msgstr "Pouze pro soukromý repozitář: token s jemně nastavenými oprávněními a přístupem k obsahu pouze pro čtení."

msgid "Firmware variant"
msgstr "Varianta firmwaru"

msgid "Must match the firmware currently installed. Changing variant is not supported from here."
msgstr "Musí odpovídat aktuálně nainstalovanému firmwaru. Změna varianty zde není podporována."

msgid "Release candidates"
msgstr "Kandidátní verze"

msgid "Also offer Dasharo release candidates (-rc) and builds of unreleased branches, for testing. They are not final releases. The final release is offered once it is out, and a release candidate is never offered over it."
msgstr "Nabízet také kandidátní verze Dasharo (-rc) a sestavení nevydaných větví, pro testování. Nejsou to finální verze. Finální verze je nabídnuta, jakmile vyjde, a kandidátní verze se místo ní nikdy nenabízí."

# System status (notification bell)
msgid "APU coreboot firmware"
msgstr "Firmware coreboot pro APU"

msgid "New firmware has been written. A cold reset is required to start it."
msgstr "Nový firmware byl zapsán. Ke spuštění je nutný studený restart."

msgid "Firmware update failed: %s"
msgstr "Aktualizace firmwaru selhala: %s"

msgid "Firmware %s is available (installed: %s)."
msgstr "Je k dispozici firmware %s (nainstalováno: %s)."

# Firmware page
msgid "Firmware"
msgstr "Firmware"

msgid "Board"
msgstr "Deska"

msgid "Installed"
msgstr "Nainstalováno"

msgid "Latest build"
msgstr "Nejnovější sestavení"

msgid "Last check"
msgstr "Poslední kontrola"

msgid "Status"
msgstr "Stav"

msgid "Check now"
msgstr "Zkontrolovat nyní"

msgid "Update firmware"
msgstr "Aktualizovat firmware"

msgid "Cold reset"
msgstr "Studený restart"

msgid "Not a PC Engines APU"
msgstr "Toto není PC Engines APU"

msgid "new"
msgstr "nový"

msgid "Not checked yet."
msgstr "Zatím nezkontrolováno."

msgid "An update is available."
msgstr "Je k dispozici aktualizace."

msgid "Up to date."
msgstr "Aktuální."

msgid "The current firmware will be backed up, then the new one written and verified. Do not cut the power during the update. A cold reset is needed afterwards to start the new firmware. Continue?"
msgstr "Aktuální firmware bude zálohován, poté bude zapsán a ověřen nový. Během aktualizace neodpojujte napájení. Poté bude ke spuštění nového firmwaru nutný studený restart. Pokračovat?"

msgid "Update"
msgstr "Aktualizovat"

msgid "Cancel"
msgstr "Zrušit"

msgid "Services will be stopped and the board powered off for a few seconds, then it will boot the new firmware. The network will be down for a few minutes. Continue?"
msgstr "Služby budou zastaveny a deska bude na několik sekund vypnuta, poté nastartuje s novým firmwarem. Síť bude několik minut nedostupná. Pokračovat?"

msgid "Restarting. Reload this page in a few minutes."
msgstr "Probíhá restart. Načtěte tuto stránku znovu za několik minut."

# Backend messages (apufw.py)
msgid "The flash is write protected (%s) and the whole image must be written: disable the protection. Nothing was written."
msgstr "Flash je chráněna proti zápisu (%s) a je nutné zapsat celý obraz: vypněte ochranu. Nic nebylo zapsáno."

msgid "The flash is write protected (%s) and covers %s: disable the protection. Nothing was written."
msgstr "Flash je chráněna proti zápisu (%s) a ochrana pokrývá %s: vypněte ochranu. Nic nebylo zapsáno."

msgid "The flash is write protected (%s): only RW_SECTION_A could be written, but the flash layout differs. Nothing was written."
msgstr "Flash je chráněna proti zápisu (%s): zapsat by šlo jen RW_SECTION_A, ale rozložení flash se liší. Nic nebylo zapsáno."

msgid "The flash is write protected (%s): only RW_SECTION_A could be written, but it is signed with other keys than the read-only part (GBB), which would reject it. Nothing was written."
msgstr "Flash je chráněna proti zápisu (%s): zapsat by šlo jen RW_SECTION_A, ale je podepsána jinými klíči než část pouze pro čtení (GBB), která by ji odmítla. Nic nebylo zapsáno."

msgid "This is not a PC Engines apu2/3/4/6 board."
msgstr "Toto není deska PC Engines apu2/3/4/6."

msgid "flashrom is not installed."
msgstr "flashrom není nainstalován."

msgid "The current firmware version could not be read."
msgstr "Verzi aktuálního firmwaru se nepodařilo přečíst."

msgid "Switching from UEFI to SeaBIOS must be done manually."
msgstr "Přechod z UEFI na SeaBIOS je nutné provést ručně."

msgid "Switching from SeaBIOS to UEFI must be done manually (OPNsense must boot in UEFI mode)."
msgstr "Přechod ze SeaBIOS na UEFI je nutné provést ručně (OPNsense musí startovat v režimu UEFI)."

msgid "Firmware %s is running."
msgstr "Běží firmware %s."

msgid "The last operation was interrupted, see the log."
msgstr "Poslední operace byla přerušena, viz protokol."

msgid "No GitHub repository configured."
msgstr "Není nastaven žádný repozitář GitHub."

msgid "Unsupported board."
msgstr "Nepodporovaná deska."

msgid "GitHub query failed: %s"
msgstr "Dotaz na GitHub selhal: %s"

msgid "No release for %s (%s) in %s."
msgstr "Žádné vydání pro %s (%s) v %s."

msgid "Unexpected error: %s"
msgstr "Neočekávaná chyba: %s"

msgid "Preparing"
msgstr "Příprava"

msgid "No newer firmware is available."
msgstr "Není k dispozici žádný novější firmware."

msgid "Downloading %s"
msgstr "Stahování %s"

msgid "Download failed: %s"
msgstr "Stahování selhalo: %s"

msgid "Checksum mismatch for %s (expected %s, got %s)."
msgstr "Nesouhlasí kontrolní součet pro %s (očekáváno %s, získáno %s)."

msgid "Backing up the current firmware"
msgstr "Zálohování aktuálního firmwaru"

msgid "Backup failed, nothing was written. Is the firmware write protection disabled?"
msgstr "Záloha selhala, nic nebylo zapsáno. Je ochrana firmwaru proti zápisu vypnutá?"

msgid "Writing %s"
msgstr "Zápis %s"

msgid "flashrom failed while writing. DO NOT REBOOT: retry the update, or restore %s with flashrom."
msgstr "flashrom selhal během zápisu. NERESTARTUJTE: zopakujte aktualizaci, nebo obnovte %s pomocí flashrom."

msgid "flashrom failed before writing, the firmware is unchanged."
msgstr "flashrom selhal před zápisem, firmware je beze změny."

msgid "Firmware %s written and verified. A cold reset is required."
msgstr "Firmware %s zapsán a ověřen. Je nutný studený restart."
