{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Tests plugin",
            "type": "shell",
            "command": "python3 -I plugin/tests/test_apufw.py plugin/sysutils/apufirmware/src/opnsense/scripts/OPNsense/ApuFirmware/apufw.py",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Lint Python",
            "type": "shell",
            "command": "flake8 --max-line-length=120 plugin",
            "group": "build",
            "problemMatcher": {
                "owner": "flake8",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.+?):(\\d+):(\\d+): (\\w\\d+) (.*)$",
                    "file": 1, "line": 2, "column": 3, "code": 4, "message": 5
                }
            }
        },
        {
            "label": "Lint Shell",
            "type": "shell",
            "command": "shellcheck -f gcc scripts/apu-fw plugin/install.sh",
            "group": "build",
            "problemMatcher": {
                "owner": "shellcheck",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.+?):(\\d+):(\\d+): (warning|error|note): (.*)$",
                    "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
                }
            }
        },
        {
            "label": "Versions Dasharo disponibles",
            "type": "shell",
            "command": "scripts/apu-fw check",
            "problemMatcher": []
        }
    ]
}
